{
  "root": true,
  "extends": ["@pega", "plugin:jest/recommended"],
  "plugins": ["jest"],
  "parserOptions": {
    "project": "tsconfig.json",
    "ecmaVersion": 13,
    "sourceType": "module"
  },
  "globals": {
    "PCore": "readonly"
  },
  "env": {
    "es6": true,
    "node": true,
    "browser": true,
    "jest": true
  },
  "settings": {
    "import/resolver": {
      "typescript": {},
      "node": {
        "extensions": [".js", ".jsx"]
      }
    },
    "react": {
      "version": "detect"
    }
  },
  "ignorePatterns": [
    "node_modules",
    "packages/*/lib",
    "!.storybook",
    ".storybook/public",
    "**/**/*.json"
  ],
  "rules": {
    "react/jsx-filename-extension": [0, { "extensions": [".js", ".jsx", ".ts", ".tsx"] }],
    "prettier/prettier": "off",
    "sonarjs/cognitive-complexity": ["warn", 20],
    "sonarjs/no-identical-functions": "off",
    "sonarjs/no-duplicate-string": "off",
    "sonarjs/no-nested-template-literals": "off",
    "sonarjs/prefer-immediate-return": "off",
    "testing-library/prefer-screen-queries": "off",
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "varsIgnorePattern": "^React$" }],
    "no-unused-vars": ["warn", { "varsIgnorePattern": "^React$" }],
    "testing-library/no-unnecessary-act": "off",
    "testing-library/no-render-in-setup": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react/no-unstable-nested-components": "off",
    "testing-library/render-result-naming-convention": "off",
    "import/extensions": ["off", "never"],
    "import/named": "off",
    "import/no-cycle": "off",
    "import/no-duplicates": "off",
    "import/no-extraneous-dependencies": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-self-import": "off",
    "import/no-unresolved": "off",
    "import/no-useless-path-segments": "off",
    "import/order": "off",
    "no-underscore-dangle": "off",
    "no-restricted-syntax": "warn",
    "no-else-return": "off",
    "jsx-a11y/alt-text": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "react/jsx-fragments": "off",
    "react/jsx-no-bind": "off",
    "react/self-closing-comp": "off",
    "@typescript-eslint/naming-convention": "off",
    "@typescript-eslint/ban-types": "off",
    "import/no-relative-packages": "off",
    "no-restricted-exports": "off" // Add this line to disable the rule globally
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {
        "@typescript-eslint/method-signature-style": ["error", "property"],
        "quotes": "off",
        "@typescript-eslint/quotes": "off"
      }
    },
    {
      "files": ["*.jsx", "*.tsx", "*.mdx"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react-hooks/exhaustive-deps": [
          "off",
          {
            "additionalHooks": "useAfterInitialEffect"
          }
        ]
      }
    },
    {
      "files": [".storybook/*.js"],
      "extends": ["@pega/eslint-config/script"]
    },
    {
      "files": ["*/**/mocks/**.@(mocks|styles).@(tsx|ts)"],
      "rules": {
        "import/prefer-default-export": ["off"]
      }
    },
    {
      "files": ["**/custom-constellation/**/*.@(js|jsx)"],
      "rules": {
        "import/no-relative-packages": "off",
        "import/prefer-default-export": "off",
        "@typescript-eslint/no-shadow": "error",
        "react/jsx-fragments": "off",
        "no-undef": "error",
        "no-console": "error",
        "prefer-regex-literals": "off",
        "sonarjs/cognitive-complexity": ["warn", 50]
      }
    },
    {
      "files": ["**/custom-constellation/**/*.@(ts|tsx)"],
      "rules": {
        "eqeqeq": "off",
        "no-alert": "off",
        "no-console": "off",
        "no-fallthrough": "error",
        "no-undef": "off",
        "no-unused-vars": "off",
        "no-var": "off",
        "yoda": "error",
        "no-irregular-whitespace": "off",
        "no-empty": "off",
        "no-new-object": "off",
        "react/jsx-fragments": "off",
        "import/prefer-default-export": "off",
        "@typescript-eslint/no-inferrable-types": "error",
        "@typescript-eslint/array-type": "off",
        "sonarjs/cognitive-complexity": ["warn", 45],
        "react-hooks/exhaustive-deps": [
          "error",
          {
            "additionalHooks": "useAfterInitialEffect"
          }
        ]
      }
    },
    {
      "files": ["**/custom-sdk/**/**/mock.stories.js"],
      "rules": {
        "storybook/default-exports": "off"
      }
    }
  ]
}
